{
    "version": 4,
    "configurations": [
        {
            "name": "CH32V20x",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/core/inc",
                "${workspaceFolder}/lib/inc",
                "${workspaceFolder}/ch32v20x/inc",
                "${workspaceFolder}/ch32v20x"
                // "C:/MounRiver/MounRiver_Studio2/resources/app/resources/win32/components/WCH/Toolchain/RISC-V Embedded GCC/riscv-none-embed/include",
                // "C:/MounRiver/MounRiver_Studio2/resources/app/resources/win32/components/WCH/Toolchain/RISC-V Embedded GCC/lib/gcc/riscv-none-embed/*/include"
            ],
            "defines": [
                "CH32V20x",
                "__riscv",
                "__riscv_xlen=32",
                "__GNUC__"
            ],
            "compilerPath": "/opt/xpack/riscv-none-embed-gcc/bin/riscv-none-embed-gcc",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64",
            "compilerArgs": [
                "-march=rv32imac",
                "-mabi=ilp32",
                "-msmall-data-limit=8",
                "-ffunction-sections",
                "-fdata-sections",
                "-fno-common"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}"
                    // "C:/MounRiver/MounRiver_Studio2/resources/app/resources/win32/components/WCH/Toolchain/RISC-V Embedded GCC/riscv-none-embed/include"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db"
            }
        }
    ]
}
