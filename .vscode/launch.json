{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/build/output/main.elf",
            
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/xpack/riscv-none-embed-gcc/bin/riscv-none-embed-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                {
                    "description": "Set architecture",
                    "text": "set architecture riscv:rv32",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "break main"
                }


            ],
            "preLaunchTask": "start openocd",
            "postDebugTask": "kill OpenOCD",
            "stopAtEntry": true,
            "externalConsole": false,
            "logging": {
                "engineLogging": false,
                "programOutput": true,
                "exceptions": true
            }
        },
        {
            "name": "Attach to Running Target",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/build/output/main.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MounRiver/MounRiver_Studio2/resources/app/resources/win32/components/WCH/Toolchain/RISC-V Embedded GCC/bin/riscv-none-embed-gdb.exe",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Connect to target",
                    "text": "target extended-remote localhost:3333",
                    "ignoreFailures": false
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false
        }
    ]
}

